{
  "name": "mabab-transcription",
  "private": true,
  "version": "1.0.0",
  "description": "Offline Kinyarwanda audio transcription desktop application",
  "author": "Mabab",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=server.mjs --watch-path=dialogue_format.mjs --watch-path=local_asr_worker.py --watch-path=voice_diarization.py server.mjs --dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "node server.mjs",
    "start": "node server.mjs",
    "desktop:run": "npm run build && electron .",
    "desktop:worker": ".\\.venv\\Scripts\\pyinstaller.exe --noconfirm --clean --onedir --name mabab-asr --distpath desktop-build/worker --workpath desktop-build/pyinstaller --specpath desktop-build --collect-all onnx_asr --collect-all onnxruntime local_asr_worker.py",
    "desktop:icon": "node scripts/create-icon.mjs",
    "desktop:assets": "npm run desktop:icon && node scripts/prepare-desktop-assets.mjs",
    "desktop:dir": "npm run build && npm run desktop:worker && npm run desktop:assets && electron-builder --win dir",
    "desktop:build": "npm run build && npm run desktop:worker && npm run desktop:assets && electron-builder --win nsis"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.mabab.transcription",
    "productName": "Mabab Transcription",
    "electronDist": "desktop-build/electron-runtime",
    "asar": true,
    "asarUnpack": [
      "server.mjs",
      "dialogue_format.mjs",
      "dist/**/*"
    ],
    "files": [
      "electron/**/*",
      "server.mjs",
      "dialogue_format.mjs",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-build/worker/mabab-asr",
        "to": "asr"
      },
      {
        "from": "desktop-resources/model",
        "to": "model"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Mabab-Transcription-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mabab Transcription"
    }
  }
}
