# Speech transcription and voice identification run locally. OpenAI polishes labeled text.
# The hosted account API stores account and request metadata in PostgreSQL.
# Add a server-side key for automatic punctuation and wording cleanup.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_DIALOGUE_MODEL=gpt-5-mini
# A token is optional and is only used for the one-time model download.
# HF_TOKEN=hf_your_token_here
# TRANSCRIPT_API_URL=https://transcription-api.5.189.188.129.sslip.io
# LOCAL_ASR_MODEL=OpenVoiceOS/w2v-bert-2.0-kinyarwanda-onnx
# LOCAL_VAD_MODEL_PATH=C:\path\to\silero_vad.onnx
# LOCAL_SPEAKER_MODEL_PATH=C:\path\to\pyannote_embedding.onnx
# LOCAL_ASR_PYTHON=C:\path\to\transcription\.venv\Scripts\python.exe
# PORT=5173
